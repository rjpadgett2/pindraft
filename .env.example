# Pindraft environment template. Copy to .env (gitignored) and fill in real values.
#
#   cp .env.example .env
#
# These same variable names feed:
#   - Local backend dev (loaded by Spring's `spring.config.import` from <repo>/.env)
#   - Production containers (docker-compose.prod.yml passes them through)

# --- Database (required, no defaults) ---------------------------------------
# For a Supabase project: Project Settings → Database → Connection string →
#   "Session pooler" → "Java/JDBC". URL looks like:
#   jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
# Username will be `postgres.<your-project-ref>`.
DATABASE_URL=jdbc:postgresql://your-host:5432/pindraft
DATABASE_USER=pindraft_app
DATABASE_PASSWORD=change-this-to-a-long-random-string

# --- JWT signing (required, no default) -------------------------------------
# Generate with:  openssl rand -base64 48
JWT_SECRET=change-this-too-make-it-very-long-and-random

# --- CORS allowlist (optional; comma-separated, no spaces) ------------------
# Defaults for local dev are the three Angular dev servers (4200/4201/4202).
# In production set this to your real subdomains.
# ALLOWED_ORIGINS=https://app.pindraft.co,https://portal.pindraft.co,https://shearer.pindraft.co
