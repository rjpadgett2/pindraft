# Nx 21 + Angular 21 currently have an unsynchronized peer-dep range on ng-packagr:
#   - @angular-devkit/build-angular@21.x wants ng-packagr@^21
#   - @nx/angular@21.x wants ng-packagr@>=18 <21
# Until Nx widens its peer range, npm 7+'s strict resolver refuses to install.
# Falling back to npm 6 semantics (warn instead of error) is the standard workaround
# in Nx workspaces and is safe — the runtime APIs of ng-packagr 20/21 are compatible.
legacy-peer-deps=true
